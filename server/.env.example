# Kelnix telemetry — environment template.
#
# Copy to /opt/kelnix-telemetry/shared/.env on the server. NO REAL SECRETS HERE;
# this file is committed.
#
# Generate secrets with:  openssl rand -base64 32

NODE_ENV=production
LOG_LEVEL=info

# Bound to loopback: nginx is the only thing that should be able to reach it.
HOST=127.0.0.1
PORT=4010

# Its own database on the existing Postgres 16 cluster — never an app's database.
DATABASE_URL=postgres://telemetry:CHANGE_ME@127.0.0.1:5432/telemetry

# Salt for deriving pseudonymous visitor ids from IP + user agent, rotated
# daily in code. This is what makes the browser tracker cookieless.
#
# MUST stay stable across restarts and deploys — changing it makes every
# returning visitor look new and inflates visitor counts for a day.
ANON_SALT=CHANGE_ME

# 32 bytes of base64, for encrypting metric-source bearer tokens at rest.
# These are read credentials into your other apps, so they are encrypted rather
# than stored plain. Rotating this invalidates stored tokens (re-enter them);
# losing it loses no data.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME

# Origins allowed to call the dashboard API with cookies. The ingest endpoints
# are deliberately not origin-restricted; they authenticate with an API key.
ADMIN_ORIGINS=https://kelnix.org,https://www.kelnix.org

# Leading dot so the session cookie works across kelnix.org subdomains.
COOKIE_DOMAIN=.kelnix.org
SESSION_TTL_DAYS=7

# Retention for raw rows. metrics_daily rollups are kept forever regardless —
# they are what the dashboard actually reads.
EVENT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# Background jobs: rollups, retention sweep, uptime checks.
JOBS_ENABLED=true
HEALTH_CHECK_INTERVAL_S=300
