{
  "name": "kelnix-telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "Kelnix telemetry collector — one API every Kelnix app reports to, and the data behind kelnix.org/admin.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/migrations && cp -R src/migrations dist/migrations",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "seed:admin": "node dist/scripts/create-admin.js",
    "seed:app": "node dist/scripts/create-app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
